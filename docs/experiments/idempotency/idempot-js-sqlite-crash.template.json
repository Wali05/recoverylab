{
  "name": "idempot-js-sqlite-crash-retry",
  "scenario": "crash-after-ack",
  "timeout": "30s",
  "service": {
    "command": [
      "node",
      "C:/path/to/recoverylab/docs/experiments/idempotency/idempot-js-sqlite-host.mjs",
      "C:/path/to/idempot-js",
      "C:/path/to/test-idempotency.db",
      "18092",
      "guard"
    ],
    "ready_url": "http://127.0.0.1:18092/health",
    "startup_timeout": "10s"
  },
  "request": {
    "method": "POST",
    "url": "http://127.0.0.1:18092/orders",
    "headers": {
      "Content-Type": "application/json",
      "Idempotency-Key": "recoverylab-{{run_id}}-sqlite"
    },
    "body": { "item": "book-{{run_id}}" }
  },
  "observe": {
    "url": "http://127.0.0.1:18092/state",
    "pointer": "/count",
    "expected_delta": 1
  },
  "retry_response": {
    "same_json_pointers": ["/id"]
  }
}
