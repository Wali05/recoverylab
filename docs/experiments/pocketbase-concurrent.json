{
  "name": "pocketbase-post-concurrent",
  "scenario": "concurrent-duplicates",
  "concurrency": 8,
  "request": {
    "method": "POST",
    "url": "http://127.0.0.1:8090/api/collections/retry_orders/records",
    "headers": { "Content-Type": "application/json" },
    "body": { "clientKey": "burst-{{run_id}}" }
  },
  "observe": {
    "url": "http://127.0.0.1:8090/api/collections/retry_orders/records?perPage=1",
    "pointer": "/totalItems",
    "expected_delta": 1
  }
}
